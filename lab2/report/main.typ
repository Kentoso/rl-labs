#img("sweep_policies.png", [Підсумкові стратегії для різних розподілів ваг]) <fig:sweeppol>

#tbl(
  caption: [Таблиця 2. Вплив ваг формування (200 × 200, 100 000 епізодів, оцінювання на 100 стартах)],
